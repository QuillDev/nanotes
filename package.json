{
  "name": "nanotes",
  "version": "0.3.14",
  "private": true,
  "description": "A Nako-styled floating Markdown scratchpad backed by local files.",
  "license": "MIT",
  "author": "QuillDev <siinspam@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuillDev/nanotes.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run --cwd desktop start",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "server": "bun run server/main.ts",
    "server:setup-link": "bun run server/setup-link.ts",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "lint": "oxlint --deny-warnings",
    "doctor": "react-doctor --yes --blocking warning",
    "test": "bun test tests/",
    "test:server": "bun test tests/server.test.ts",
    "test:collab": "bun test tests/collab.test.ts",
    "test:editor": "node scripts/test-editor.mjs",
    "test:desktop": "cd desktop && node --test \"test/*.test.js\"",
    "check": "bun run typecheck && bun run lint && bun run doctor && bun run test && bun run test:desktop && bun run build && bun run build:web"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@elysiajs/eden": "^1.4.9",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.10",
    "elysia": "^1.4.32",
    "lucide-react": "^1.82.0",
    "nakomponents": "github:QuillDev/nakomponents#57ced4251d654ec1b45527f6fd51976b35846107",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "playwright": "^1.64.0",
    "react-doctor": "^0.9.23",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
