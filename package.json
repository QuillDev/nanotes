{
  "name": "nanotes",
  "version": "0.3.11",
  "private": true,
  "description": "A Nako-styled floating Markdown scratchpad backed by local files.",
  "license": "MIT",
  "author": "QuillDev <siinspam@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuillDev/nanotes.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:web": "bun build src/web-app.tsx --outdir dist-web --target browser --minify",
    "tauri:build": "tauri build",
    "server": "bun run server/main.ts",
    "server:setup-link": "bun run server/setup-link.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:server": "bun test tests/server.test.ts",
    "check": "tsc && vite build && bun run build:web && tsc -p tsconfig.server.json",
    "test:editor": "node scripts/test-editor.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "~2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
